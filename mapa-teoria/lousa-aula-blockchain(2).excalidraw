      "isDeleted": false,
      "boundElements": [],
      "updated": 1790206890959,
      "created": 1790206454214,
      "link": null,
      "locked": false,
      "text": "\n\n1) Mensagem\n\n2) Chave de criptografia\n\n3) Algoritmo de criptografia (XOR)\n\n4) Quebrar a mensagem em blocos e criptografar\n\n5) Juntar os blocos criptografados\n\n6) Descriptar a mensagem cifrada para tirar a prova real",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\n1) Mensagem\n\n2) Chave de criptografia\n\n3) Algoritmo de criptografia (XOR)\n\n4) Quebrar a mensagem em blocos e criptografar\n\n5) Juntar os blocos criptografados\n\n6) Descriptar a mensagem cifrada para tirar a prova real",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
